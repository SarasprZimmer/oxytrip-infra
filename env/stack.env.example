# Copy to env/stack.env (gitignored). Never commit a production SHA here if
# this file is shared — the live pin belongs in the server's env/stack.env only.

# Staging (moving tag published from main):
FRONTEND_TAG=staging
PANEL_TAG=staging

# Production: pin a git SHA. Never staging, latest, or prod.
# FRONTEND_TAG=0123456789abcdef0123456789abcdef01234567
# PANEL_TAG=0123456789abcdef0123456789abcdef01234567
# SITE_DOMAIN=www.example.com
# PANEL_DOMAIN=panel.example.com
# ACME_EMAIL=ops@example.com
