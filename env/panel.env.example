# Copy to env/panel.env — never commit real secrets.
# Unified panel: CMS (Next/Payload :3000) + bot (Express :4000) + internal Caddy (:8080).
# See Oxytrip-cms/oxytrip-cms/.env.example and bot/.env.example.

# ── runtime (container) ─────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── CMS (from oxytrip-cms/.env.example) ─────────────────────────────────────
PAYLOAD_SECRET=
MONGODB_URI=
# Public URL including /cms suffix — Payload basePath is /cms
NEXT_PUBLIC_SERVER_URL=
FRONTEND_URL=
REVALIDATION_SECRET=

# S3-compatible media (Cloudflare R2 in production)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Bot (from oxytrip-cms/bot/.env.example) ────────────────────────────────
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_AGENT_GROUP_ID=
TELEGRAM_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
JWT_SECRET=
DASHBOARD_PASSWORD_HASH=
GREEN_API_WEBHOOK_TOKEN=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
TRIPSCRIPT_API_KEY=
BOT_PORT=4000
DB_PATH=/app/bot/data/support.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CORS_ORIGINS=
CLIENT_BUSINESS_NAME=Oxytrip
CLIENT_INDUSTRY=travel
CONFIDENCE_THRESHOLD=0.75
MAX_COLLECTOR_TURNS=6
LOG_LEVEL=info
