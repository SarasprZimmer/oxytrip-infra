# Copy to env/frontend.env — never commit real secrets.
# Contract: npm run env:required in oxytrip-frontend (scripts/print-required-env.ts)

# ── required (startup fails if missing, any NODE_ENV) ───────────────────────
# runtime
PAYLOAD_API_URL=
NEXTAUTH_SECRET=
SITE_URL=

# ── required in production (startup fails when NODE_ENV=production) ───────
# runtime
REVALIDATION_SECRET=
BOT_WEBHOOK_SECRET=
TRIPSCRIPT_BASE_URL=
TRIPSCRIPT_API_KEY=
# runtime — either satisfies
BOT_URL=
# build-time (also set as Docker build-arg NEXT_PUBLIC_BOT_URL in local overlay)
NEXT_PUBLIC_BOT_URL=

# ── warn in production (logs only; Google sign-in breaks silently if unset) ─
# runtime
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── expected empty on the public site ───────────────────────────────────────
# runtime — non-empty bypasses published-only CMS filter
PAYLOAD_API_KEY=

# ── build-time (Dockerfile.local args — baked into the client bundle) ───────
# NEXT_PUBLIC_BASE_URL=
# NEXT_PUBLIC_CMS_PROVIDER=payload
# NEXT_PUBLIC_BOT_WEBHOOK_SECRET=
# NEXT_IMAGE_UNOPTIMIZED=true

# ── runtime (server) ────────────────────────────────────────────────────────
NODE_ENV=production
TRIPSCRIPT_HOTEL_BASE_URL=
TRIPSCRIPT_TIMEOUT_MS=60000
GOOGLE_BRIDGE_PASSWORD_SECRET=
